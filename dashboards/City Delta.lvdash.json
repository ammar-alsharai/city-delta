{
  "datasets": [
    {
      "name": "86acc01c",
      "displayName": "around_me",
      "queryLines": [
        "WITH place AS (\r\n",
        "  SELECT place_name, p_lat, p_lon\r\n",
        "  FROM VALUES\r\n",
        "    ('Den Haag Centraal', 52.0809, 4.3248),\r\n",
        "    ('Den Haag HS',       52.0697, 4.3225),\r\n",
        "    ('Binnenhof / Plein', 52.0799, 4.3131),\r\n",
        "    ('Scheveningen',      52.1115, 4.2786),\r\n",
        "    ('Statenkwartier',    52.0890, 4.2860),\r\n",
        "    ('Laakkwartier',      52.0680, 4.3360),\r\n",
        "    ('Ypenburg',          52.0440, 4.3650)\r\n",
        "  AS p(place_name, p_lat, p_lon)\r\n",
        "  WHERE place_name = :place\r\n",
        "),\r\n",
        "win AS (\r\n",
        "  SELECT\r\n",
        "    CASE :period\r\n",
        "      WHEN 'Today' THEN current_date()\r\n",
        "      WHEN 'This weekend' THEN\r\n",
        "        CASE WHEN dayofweek(current_date()) = 1 THEN date_sub(current_date(), 1)   -- Sunday: weekend started yesterday\r\n",
        "             ELSE next_day(date_sub(current_date(), 1), 'SA') END                  -- next Saturday (or today)\r\n",
        "      ELSE current_date()                                                          -- 'Next 7 days'\r\n",
        "    END AS w_start\r\n",
        "),\r\n",
        "win2 AS (\r\n",
        "  SELECT w_start,\r\n",
        "         CASE :period WHEN 'Today' THEN w_start\r\n",
        "                      WHEN 'This weekend' THEN date_add(w_start, 1)\r\n",
        "                      ELSE date_add(w_start, 6) END AS w_end\r\n",
        "  FROM win\r\n",
        "),\r\n",
        "dist AS (\r\n",
        "  SELECT h.*, w.w_start, w.w_end,\r\n",
        "         2 * 6371000 * asin(sqrt(\r\n",
        "             pow(sin(radians(h.lat - p.p_lat) / 2), 2) +\r\n",
        "             cos(radians(p.p_lat)) * cos(radians(h.lat)) *\r\n",
        "             pow(sin(radians(h.lon - p.p_lon) / 2), 2))) AS distance_m\r\n",
        "  FROM city_lens.gold.happenings_enriched h\r\n",
        "  CROSS JOIN place p\r\n",
        "  CROSS JOIN win2 w\r\n",
        "  WHERE h.location_ok\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  happening_id,\r\n",
        "  initcap(replace(category, '_', ' '))                  AS category_label,\r\n",
        "  stage, title, description, lat, lon,\r\n",
        "  CAST(round(distance_m) AS INT)                        AS distance_m,\r\n",
        "  coalesce(date_format(start_local, 'd MMM'), date_format(published_date, 'd MMM')) AS from_date,\r\n",
        "  date_format(end_local, 'd MMM')                       AS to_date,\r\n",
        "  status, url,\r\n",
        "  concat_ws(' · ',\r\n",
        "    CASE WHEN badge_rain_risk      THEN concat('Rain ', day_rain_pct, '%') END,\r\n",
        "    CASE WHEN badge_closure_nearby THEN 'Closure nearby' END,\r\n",
        "    CASE WHEN badge_permit_only    THEN 'Permit only' END)              AS badges,\r\n",
        "  CASE WHEN closure_level = 'road_closed' THEN 1 ELSE 0 END             AS is_closure,\r\n",
        "  CASE WHEN category IN ('event_permit', 'road_event') THEN 1 ELSE 0 END AS is_event,\r\n",
        "  CASE WHEN badge_rain_risk THEN 1 ELSE 0 END                           AS is_rain_risk\r\n",
        "FROM dist\r\n",
        "WHERE distance_m <= :radius_km * 1000\r\n",
        "  AND (\r\n",
        "        (time_basis = 'scheduled' AND to_date(start_local) <= w_end AND to_date(end_local) >= w_start)\r\n",
        "     OR (time_basis = 'published' AND published_date >= date_sub(current_date(), 30))\r\n",
        "      )"
      ],
      "parameters": [
        {
          "displayName": "place",
          "keyword": "place",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Den Haag Centraal"
                }
              ]
            }
          }
        },
        {
          "displayName": "period",
          "keyword": "period",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Next 7 days"
                }
              ]
            }
          }
        },
        {
          "displayName": "radius_km",
          "keyword": "radius_km",
          "dataType": "DECIMAL",
          "defaultSelection": {
            "values": {
              "dataType": "DECIMAL",
              "values": [
                {
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4a0fa1b1",
      "displayName": "weather_today",
      "queryLines": [
        "SELECT max_rain_pct, max_temp_c\r\n",
        "FROM city_lens.gold.daily_activity\r\n",
        "WHERE city_key = 'den_haag' AND day = current_date()"
      ]
    }
  ],
